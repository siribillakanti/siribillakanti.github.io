# ===================================================================
# SIRI BILLAKANTI PORTFOLIO — ENVIRONMENT VARIABLES
# ===================================================================
# Copy this file to .env.local for local development.
# For GitHub Pages / GitHub Actions, configure these in:
# Repository Settings -> Secrets and variables -> Actions -> Secrets
# ===================================================================

# 1. Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Public Anon / Publishable Key (safe for client-side use)
# NEVER commit or put your service_role secret here!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Designated Admin User UUID (Found in Supabase -> Authentication -> Users)
# Only this UUID can access the admin dashboard when Supabase Auth is active.
VITE_ADMIN_USER_ID=your-supabase-user-uuid-here
